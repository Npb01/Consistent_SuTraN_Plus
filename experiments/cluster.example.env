# Cluster configuration -- copy to cluster.env (git-ignored) and `source` it
# before running deploy/fetch (locally) or submit (on the server). All values
# are site-specific; none are committed.
#
#   cp experiments/cluster.example.env experiments/cluster.env
#   # edit cluster.env, then:
#   source experiments/cluster.env
#
# The SSH host for deploy.sh/fetch.sh is passed as their first argument (or set
# up an alias in ~/.ssh/config and pass that), so it is not configured here.

# Where the code lives on the cluster: the rsync target for deploy.sh/fetch.sh
# and the working directory the SLURM jobs run in. Relative paths are under the
# remote home; use an absolute path for a scratch or project filesystem.
export REMOTE_DIR="thesis"

# SLURM resources. When set, these OVERRIDE the per-sweep defaults declared in
# experiments/sweeps.py, so a new cluster needs no edits there. Leave any of
# them empty to keep the sweep's own value.
export SLURM_PARTITION=""   # e.g. "gpu"
export SLURM_GRES=""        # e.g. "gpu:1"
export SLURM_ACCOUNT=""     # optional; omit on clusters that don't require one
