# ─── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ─── Virtual environments ─────────────────────────────────
.venv/
venv/
env/

# ─── Event-log data & preprocessed tensors (inputs: keep local, never commit) ─
