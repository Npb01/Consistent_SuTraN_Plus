*.zip
*.pt           # preprocessed tensors AND model checkpoints
*.pth
*.ckpt
*.pkl          # cardinality dicts, categ mappings, consistency_diagnostics.pkl, ...

# Data / preprocessed-tensor directories (also hold results subfolders)
BPIC_17/
BPIC_17_DR/
BPIC_19/

# ─── Experiment outputs & results (regenerate, don't commit) ──
run_logs/
hpc_logs/
aggregate_results/
figures/
step_error_cache/
runs/                 # tensorboard event dirs
*.tfevents.*
*.out
*.err

